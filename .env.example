# Copy to .env and adjust. Never commit real credentials.

# Control-plane Postgres (matches infrastructure/compose/dev.yml)
DATABASE_URL=postgres://rivet:rivet@localhost:5432/rivet

# Authentication (@rivet/auth — consumed by the server from PR-3 onward)
# Generate with: openssl rand -base64 32
RIVET_AUTH_SECRET=
# Canonical base URL of this deployment — with the web app's /api proxy in
# front (apps/web), this is the WEB origin so cookies and origin checks align
RIVET_BASE_URL=http://localhost:3000
# Where the web app's /api proxy forwards to (apps/web, build/dev time)
RIVET_API_URL=http://localhost:3001
# API server port (apps/server)
PORT=3001
# Extra origins allowed past the CSRF checks (comma-separated, optional)
# RIVET_TRUSTED_ORIGINS=https://app.example.com
