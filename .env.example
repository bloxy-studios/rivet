# Copy to .env and adjust. Never commit real credentials.

# Control-plane Postgres (matches infrastructure/compose/dev.yml)
DATABASE_URL=postgres://rivet:rivet@localhost:5432/rivet

# Authentication (@rivet/auth — consumed by the server from PR-3 onward)
# Generate with: openssl rand -base64 32
RIVET_AUTH_SECRET=
# Canonical base URL of this deployment
RIVET_BASE_URL=http://localhost:3000
