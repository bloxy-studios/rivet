{
  "name": "rivet",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun run --filter @rivet/database generate",
    "db:migrate": "bun run --filter @rivet/database migrate",
    "db:seed": "bun run --filter @rivet/database seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
